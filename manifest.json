{
  "schemaVersion": 1,
  "id": "foamy.audio",
  "name": "Foamy Audio",
  "version": "1.1.0",
  "author": "foamrider",
  "description": "Audio outputs, microphones, per-app volumes and AirPlay",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "Panel.qml"
  },
  "barWidget": {
    "displayName": "Audio",
    "description": "Volume, device selection and per-app mixer",
    "category": "Audio",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "showPercentage": true
    },
    "schema": [
      {
        "key": "showPercentage",
        "type": "boolean",
        "label": "Show percentage in the bar",
        "defaultValue": true
      }
    ]
  },
  "license": "MIT"
}
